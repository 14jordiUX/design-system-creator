      "2xs": {
        "$value": "{space.1}"
      },
      "xs": {
        "$value": "{space.1-5}"
      },
      "sm": {
        "$value": "{space.2}"
      },
      "md": {
        "$value": "{space.3}"
      },
      "lg": {
        "$value": "{space.4}"
      },
      "xl": {
        "$value": "{space.6}"
      },
      "2xl": {
        "$value": "{space.8}"
      },
      "3xl": {
        "$value": "{space.12}"
      },
      "4xl": {
        "$value": "{space.16}"
      }
    },
    "gap": {
      "$description": "Separación entre elementos (gap, márgenes)",
      "3xs": {
        "$value": "{space.0-5}"
      },
      "2xs": {
        "$value": "{space.1}"
      },
      "xs": {
        "$value": "{space.1-5}"
      },
      "sm": {
        "$value": "{space.2}"
      },
      "md": {
        "$value": "{space.3}"
      },
      "lg": {
        "$value": "{space.4}"
      },
      "xl": {
        "$value": "{space.6}"
      },
      "2xl": {
        "$value": "{space.8}"
      },
      "3xl": {
        "$value": "{space.12}"
      },
      "4xl": {
        "$value": "{space.16}"
      }
    },
    "section": {
      "$value": "{space.16}",
      "$description": "Separación entre secciones de página"
    }
  },
  "radius": {
    "$type": "dimension",
    "control": {
      "$value": "{radius.md}",
      "$description": "Botones, campos, selects"
    },
    "card": {
      "$value": "{radius.lg}",
      "$description": "Tarjetas y paneles"
    },
    "overlay": {
      "$value": "{radius.xl}",
      "$description": "Modales, popovers"
    },
    "pill": {
      "$value": "{radius.full}",
      "$description": "Badges, avatares, toggles"
    },
    "inner": {
      "$value": "{radius.sm}",
      "$description": "Elementos dentro de un control (opciones de menú, casillas)"
    },
    "fine": {
      "$value": "{radius.xs}",
      "$description": "Detalles pequeños"
    },
    "square": {
      "$value": "{radius.none}",
      "$description": "Sin redondeo"
    }
  },
  "elevation": {
    "$type": "shadow",
    "flat": {
      "$value": "{shadow.sm}"
    },
    "raised": {
      "$value": "{shadow.md}",
      "$description": "Tarjetas elevadas, dropdowns"
    },
    "overlay": {
      "$value": "{shadow.lg}",
      "$description": "Popovers, menús"
    },
    "modal": {
      "$value": "{shadow.xl}"
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "micro": {
        "$value": "{duration.fast}",
        "$description": "Hover, foco"
      },
      "default": {
        "$value": "{duration.normal}"
      },
      "emphasis": {
        "$value": "{duration.slow}",
        "$description": "Modales, paneles"
      },
      "loop": {
        "$value": "{duration.loop}"
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "default": {
        "$value": "{easing.standard}"
      },
      "emphasis": {
        "$value": "{easing.emphasized}",
        "$description": "Cambios de forma grandes (la barra de pestañas flotante que se encoge)"
      }
    },
    "scale": {
      "$type": "number",
      "enter": {
        "$value": "{scale.95}",
        "$description": "Escala inicial al aparecer (menús, diálogos)"
      }
    },
    "distance": {
      "$type": "dimension",
      "enter": {
        "$value": "{space.2}",
        "$description": "Desplazamiento al aparecer"
      },
      "scroll": {
        "$value": "{space.6}",
        "$description": "Cuánto hay que bajar o subir para que algo reaccione al scroll (barra de pestañas flotante)"
      }
    },
    "rotate": {
      "$type": "other",
      "tilt": {
        "$value": "{angle.45}",
        "$description": "Giro de un octavo (un + que se convierte en ×)"
      },
      "turn": {
        "$value": "{angle.90}",
        "$description": "Giro de un cuarto (flechas de submenú, iconos que cambian)"
      },
      "flip": {
        "$value": "{angle.180}",
        "$description": "Media vuelta (flecha de un acordeón o un select abiertos)"
      }
    }
  },
