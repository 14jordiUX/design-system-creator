        "$value": "38px"
      },
      "5xl": {
        "$value": "52px"
      },
      "6xl": {
        "$value": "64px"
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "semibold": {
        "$value": 600
      },
      "bold": {
        "$value": 700
      }
    },
    "line-height": {
      "$type": "number",
      "tight": {
        "$value": 1.15
      },
      "snug": {
        "$value": 1.3
      },
      "normal": {
        "$value": 1.5
      },
      "relaxed": {
        "$value": 1.7
      }
    },
    "letter-spacing": {
      "$type": "dimension",
      "tight": {
        "$value": "-0.02em"
      },
      "normal": {
        "$value": "0em"
      },
      "wide": {
        "$value": "0.04em"
      }
    }
  },
  "shadow": {
    "$type": "shadow",
    "sm": {
      "$value": {
        "color": "#0000000b",
        "offsetX": "0px",
        "offsetY": "1px",
        "blur": "2px",
        "spread": "0px"
      }
    },
    "md": {
      "$value": {
        "color": "#00000014",
        "offsetX": "0px",
        "offsetY": "4px",
        "blur": "8px",
        "spread": "-2px"
      }
    },
    "lg": {
      "$value": {
        "color": "#00000018",
        "offsetX": "0px",
        "offsetY": "12px",
        "blur": "24px",
        "spread": "-4px"
      }
    },
    "xl": {
      "$value": {
        "color": "#0000001f",
        "offsetX": "0px",
        "offsetY": "24px",
        "blur": "48px",
        "spread": "-8px"
      }
    }
  },
  "duration": {
    "$type": "duration",
    "instant": {
      "$value": "0ms"
    },
    "fast": {
      "$value": "130ms"
    },
    "normal": {
      "$value": "220ms"
    },
    "slow": {
      "$value": "350ms"
    },
    "loop": {
      "$value": "1600ms",
      "$description": "Animaciones que se repiten (carga)"
    }
  },
  "easing": {
    "$type": "cubicBezier",
    "standard": {
      "$value": [
        0.2,
        0,
        0,
        1
      ]
    },
    "enter": {
      "$value": [
        0,
        0,
        0.2,
        1
      ]
    },
    "exit": {
      "$value": [
        0.4,
        0,
        1,
        1
      ]
    }
  },
  "opacity": {
    "$type": "number",
    "disabled": {
      "$value": 0.5
    },
    "overlay": {
      "$value": 0.6
    }
  },
  "breakpoint": {
    "$type": "dimension",
    "sm": {
      "$value": "640px"
    },
    "md": {
      "$value": "768px"
    },
    "lg": {
      "$value": "1024px"
    },
    "xl": {
      "$value": "1280px"
    }
  }
