      "$type": "fontFamily",
      "sans": {
        "$value": [
          "Inter",
          "ui-sans-serif",
          "system-ui",
          "sans-serif"
        ]
      },
      "serif": {
        "$value": [
          "Georgia",
          "ui-serif",
          "serif"
        ]
      },
      "mono": {
        "$value": [
          "JetBrains Mono",
          "ui-monospace",
          "monospace"
        ]
      }
    },
    "size": {
      "$type": "dimension",
      "xs": {
        "$value": "12px"
      },
      "sm": {
