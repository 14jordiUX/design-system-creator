{
  "color": {
    "$type": "color",
    "bg": {
      "default": {
        "$value": "{color.neutral.950}",
        "$description": "Fondo de la página"
      },
      "subtle": {
        "$value": "{color.neutral.900}"
      },
      "muted": {
        "$value": "{color.neutral.800}",
        "$description": "Zonas secundarias, filas alternas"
      },
      "inverse": {
        "$value": "{color.neutral.50}"
      }
    },
    "surface": {
      "card": {
        "$value": "{color.neutral.900}",
        "$description": "Tarjetas"
      },
      "popover": {
        "$value": "{color.neutral.900}",
        "$description": "Menús, popovers, tooltips"
      },
      "overlay": {
        "$value": "#09090b99",
        "$description": "Velo detrás de modales"
      },
      "sidebar": {
        "$value": "{color.neutral.900}",
        "$description": "Fondo de la barra lateral"
      }
    },
    "text": {
      "default": {
        "$value": "{color.neutral.50}",
        "$description": "Texto principal"
      },
      "muted": {
        "$value": "{color.neutral.400}",
        "$description": "Texto secundario"
      },
      "subtle": {
        "$value": "{color.neutral.500}",
        "$description": "Placeholders, deshabilitado"
      },
      "inverse": {
        "$value": "{color.neutral.950}"
      },
      "link": {
        "$value": "{color.brand.400}"
      }
    },
    "border": {
      "default": {
        "$value": "{color.neutral.800}"
      },
      "strong": {
        "$value": "{color.neutral.700}"
      },
      "input": {
        "$value": "{color.neutral.800}",
        "$description": "Borde de campos de formulario"
      },
      "focus": {
        "$value": "{color.brand.400}",
        "$description": "Anillo de foco"
      }
    },
    "action": {
      "primary": {
        "default": {
          "$value": "{color.brand.300}"
        },
        "hover": {
          "$value": "{color.brand.400}"
        },
        "active": {
          "$value": "{color.brand.500}"
        },
        "on": {
          "$value": "{color.brand.950}",
          "$description": "Texto/icono sobre primary"
        },
        "subtle": {
          "$value": "{color.brand.950}",
          "$description": "Fondo suave (tags, selección)"
        }
      },
      "secondary": {
        "default": {
          "$value": "{color.neutral.800}"
        },
        "hover": {
          "$value": "{color.neutral.700}"
        },
        "active": {
          "$value": "{color.neutral.600}"
        },
        "on": {
          "$value": "{color.neutral.50}"
        }
      },
      "ghost": {
        "hover": {
          "$value": "{color.neutral.800}"
        },
        "on": {
          "$value": "{color.neutral.50}"
        }
      },
      "disabled": {
        "default": {
          "$value": "{color.neutral.800}"
        },
        "on": {
          "$value": "{color.neutral.600}"
        }
      }
    },
    "feedback": {
      "success": {
        "solid": {
          "$value": "{color.green.700}",
          "$description": "Fondo sólido (badges, botones)"
        },
        "on-solid": {
          "$value": "{color.white}",
          "$description": "Texto sobre el fondo sólido"
        },
        "subtle": {
          "$value": "{color.green.950}",
          "$description": "Fondo suave de alertas"
        },
        "border": {
          "$value": "{color.green.800}"
        },
        "text": {
          "$value": "{color.green.300}"
        }
      },
      "warning": {
        "solid": {
          "$value": "{color.amber.500}",
          "$description": "Fondo sólido (badges, botones)"
        },
        "on-solid": {
          "$value": "{color.neutral.950}",
          "$description": "Texto sobre el fondo sólido"
        },
        "subtle": {
          "$value": "{color.amber.950}",
          "$description": "Fondo suave de alertas"
        },
        "border": {
          "$value": "{color.amber.800}"
        },
        "text": {
          "$value": "{color.amber.300}"
        }
      },
      "danger": {
        "solid": {
          "$value": "{color.red.600}",
          "$description": "Fondo sólido (badges, botones)"
        },
        "on-solid": {
          "$value": "{color.white}",
          "$description": "Texto sobre el fondo sólido"
        },
        "subtle": {
          "$value": "{color.red.950}",
          "$description": "Fondo suave de alertas"
        },
        "border": {
          "$value": "{color.red.800}"
        },
        "text": {
          "$value": "{color.red.300}"
        },
        "hover": {
          "$value": "{color.red.700}",
          "$description": "Fondo sólido de peligro al pasar el ratón"
        }
      },
      "info": {
        "solid": {
          "$value": "{color.blue.600}",
          "$description": "Fondo sólido (badges, botones)"
        },
        "on-solid": {
          "$value": "{color.white}",
          "$description": "Texto sobre el fondo sólido"
        },
        "subtle": {
          "$value": "{color.blue.950}",
          "$description": "Fondo suave de alertas"
        },
        "border": {
          "$value": "{color.blue.800}"
        },
        "text": {
          "$value": "{color.blue.300}"
        }
      }
    },
    "chart": {
      "$description": "Colores de series en gráficos",
      "1": {
        "$value": "{color.brand.400}"
      },
      "2": {
        "$value": "{color.green.400}"
      },
      "3": {
        "$value": "{color.amber.400}"
      },
      "4": {
        "$value": "{color.blue.400}"
      },
      "5": {
        "$value": "{color.red.400}"
      }
    }
  }
}
